# Fallback credential source if keyring is unavailable.
# Preferred: store credentials in macOS Keychain via:
#   keyring set courtbot santa-clara:username
#   keyring set courtbot santa-clara:password
#
# Per-facility env vars take the form COURTBOT_{FACILITY_ID_UPPER}_USERNAME / _PASSWORD
COURTBOT_SANTA_CLARA_USERNAME=
COURTBOT_SANTA_CLARA_PASSWORD=
